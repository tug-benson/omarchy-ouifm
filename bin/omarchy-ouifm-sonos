#!/usr/bin/env python3
"""Send OUI FM stream to Sonos via SoCo. Tries omasonos venv first, falls back to scan_network and hint IP."""
import sys, os, subprocess, time

def find_python():
    candidates = [
        os.path.expanduser("~/.local/share/io.github.ctl0v0.omasonos/venv/bin/python"),
        "/usr/bin/python3",
    ]
    for p in candidates:
        if os.path.exists(p):
            try:
                out = subprocess.run([p, "-c", "import soco"], capture_output=True, timeout=3)
                if out.returncode == 0:
                    return p
            except: pass
    return sys.executable

def main():
    if len(sys.argv) < 2:
        print("usage: omarchy-ouifm-sonos <stream_url> [title] [sonos_ip]", file=sys.stderr)
        sys.exit(1)
    uri = sys.argv[1]
    title = sys.argv[2] if len(sys.argv) > 2 else "OUI FM"
    hint_ip = sys.argv[3] if len(sys.argv) > 3 else ""
    py = find_python()
    if py != sys.executable:
        os.execv(py, [py] + sys.argv)
    try:
        import soco
        from soco.discovery import scan_network
    except Exception as e:
        try:
            import soco
            scan_network = None
        except Exception as e2:
            print(f"soco not available: {e2}", file=sys.stderr)
            sys.exit(1)
        if scan_network is None:
            scan_network = None
    zones = None
    # 1. SSDP discover
    try:
        zones = soco.discover(timeout=5)
    except Exception as e:
        print(f"discover failed: {e}", file=sys.stderr)
        zones = None
    # 2. Network scan fallback (like OmaSonos)
    if not zones and scan_network:
        try:
            print("SSDP found nothing, trying scan_network...", file=sys.stderr)
            zones = scan_network()
        except Exception as e:
            print(f"scan_network failed: {e}", file=sys.stderr)
            zones = None
    # 3. Direct hint IP fallback (from OmaSonos snapshot)
    if not zones and hint_ip:
        try:
            print(f"Trying hint IP {hint_ip}", file=sys.stderr)
            z = soco.SoCo(hint_ip)
            z.player_name
            zones = {z}
        except Exception as e:
            print(f"hint IP failed: {e}", file=sys.stderr)
            zones = None
    if not zones:
        print("No Sonos found on network (discover + scan + hint failed)", file=sys.stderr)
        sys.exit(1)
    zone = None
    for z in zones:
        try:
            if z.is_coordinator:
                zone = z
                break
        except: pass
    if zone is None:
        zone = list(zones)[0]
    print(f"Sending {uri} to Sonos {zone.player_name} ({zone.ip_address}) title={title}", file=sys.stderr)
    try:
        zone.play_uri(uri, title=title)
        time.sleep(0.5)
        print("ok")
    except Exception as e:
        print(f"play_uri failed: {e}", file=sys.stderr)
        import traceback; traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    main()

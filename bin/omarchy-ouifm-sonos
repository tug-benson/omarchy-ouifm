#!/usr/bin/env python3
"""Send OUI FM stream to Sonos via SoCo (discovery). Tries omasonos venv first."""
import sys, os, subprocess, json, time, urllib.parse

def find_python():
    candidates = [
        os.path.expanduser("~/.local/share/io.github.ctl0v0.omasonos/venv/bin/python"),
        "/usr/bin/python3",
    ]
    for p in candidates:
        if os.path.exists(p):
            # test soco import
            try:
                out = subprocess.run([p, "-c", "import soco"], capture_output=True, timeout=3)
                if out.returncode == 0:
                    return p
            except: pass
    return sys.executable

def main():
    if len(sys.argv) < 2:
        print("usage: omarchy-ouifm-sonos <stream_url> [title]", file=sys.stderr)
        sys.exit(1)
    uri = sys.argv[1]
    title = sys.argv[2] if len(sys.argv) > 2 else "OUI FM"
    # Try to find soco via omasonos venv or system
    py = find_python()
    # Re-exec with correct python if needed
    if py != sys.executable:
        os.execv(py, [py] + sys.argv)
    # Now we have soco
    try:
        import soco
    except Exception as e:
        print(f"soco not available: {e}", file=sys.stderr)
        sys.exit(1)
    # Discover with timeout
    try:
        zones = soco.discover(timeout=5)
    except Exception as e:
        print(f"discover failed: {e}", file=sys.stderr)
        sys.exit(1)
    if not zones:
        print("No Sonos found on network", file=sys.stderr)
        sys.exit(1)
    # Pick coordinator of first household or first zone
    # Prefer zone that is coordinator
    zone = None
    for z in zones:
        try:
            if z.is_coordinator:
                zone = z
                break
        except:
            pass
    if zone is None:
        zone = list(zones)[0]
    # Try to get target from OmaSonos snapshot if available (selected room)
    # For now use discovered zone
    print(f"Sending {uri} to Sonos {zone.player_name} ({zone.ip_address})", file=sys.stderr)
    try:
        # Use play_uri with metadata
        # SoCo's play_uri handles radio: uri, title, meta
        zone.play_uri(uri, title=title)
        # Ensure playing
        time.sleep(0.5)
        # zone.play() # play_uri already plays
        print("ok")
    except Exception as e:
        print(f"play_uri failed: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
